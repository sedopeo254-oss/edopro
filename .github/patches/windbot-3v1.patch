@@ -217,0 +225,11 @@ namespace WindBot.Game
+        private bool IsValidFieldSequence(CardLocation loc, int player, int seq)
+        {
+            if (player < 0 || player >= Fields.Length)
+                return false;
+            if (loc == CardLocation.MonsterZone)
+                return seq >= 0 && seq < Fields[player].MonsterZone.Length;
+            if (loc == CardLocation.SpellZone)
+                return seq >= 0 && seq < Fields[player].SpellZone.Length;
+            return true;
+        }
