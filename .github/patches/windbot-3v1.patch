+        public static Executor InstantiateKingOfAnime(GameAI ai, Duel duel, Deck deck)
+        {
+            string profile = FindAnimeProfile(deck);
+            if (profile != null)
+            {
+                Logger.WriteLine("King of Anime selected the " + profile + " strategy profile.");
+                return Instantiate(ai, duel, profile);
+            }
+            Logger.WriteLine("King of Anime is using its deterministic general anime strategy.");
+            return Instantiate(ai, duel, "KingOfAnime");
+        }
+
+        private static string FindAnimeProfile(Deck deck)
+        {
+            if (deck == null)
+                return null;
+            HashSet<int> cards = new HashSet<int>(deck.Cards.Concat(deck.ExtraCards));
+            string closestProfile = FindClosestKingProfile(cards);
+            if (closestProfile != null)
+                return closestProfile;
+            if (cards.Contains(55410871))
+                return "BlueEyesMaxDragon";
+            if (HasAny(cards, 89631139, 38517737, 59822133))
+                return "Blue-Eyes";
+            if (HasAny(cards, 37818794, 6172122))
+                return "Dragun";
+            if (HasAny(cards, 46986414, 47222536, 48680970))
+                return "DarkMagician";
+            if (HasAny(cards, 70095154, 74157028, 1546123))
+                return "CyberDragon";
+            if (HasAny(cards, 78371393, 90829280, 80453041))
+                return "Yubel";
+            if (HasAny(cards, 50251045, 96345184, 23856331))
+                return "SacredBeast";
+            if (HasAny(cards, 84013237, 81471108, 45082499))
+                return "Zexal Weapons";
+            if (HasAny(cards, 91351370, 2009101, 69031175))
+                return "Blackwing";
+            if (HasAny(cards, 1861629, 62706865, 35595518))
+                return "ST1732";
+            if (HasAny(cards, 26889158, 87871125, 41463181))
+                return "Salamangreat";
+            if (HasAny(cards, 61283655, 35371948, 35199656))
+                return "Trickstar";
+            if (HasAny(cards, 42790071, 53143898, 25533642))
+                return "Altergeist";
+            if (HasAny(cards, 47355498, 17393207, 24317029))
+                return "Gravekeeper";
+            if (HasAny(cards, 65247798, 92246806, 28630501))
+                return "Yosenju";
+            if (HasAny(cards, 19510093, 90361010, 33918636))
+                return "SuperheavySamurai";
+            if (HasAny(cards, 73580471, 12213463, 26118970, 33698022))
+                return "Level VIII";
+            if (HasAny(cards, 28649820, 95561146, 85888377, 97800311))
+                return "Apophis";
+            if (HasAny(cards, 31786629, 15291624, 41685633))
+                return "ThunderDragon";
+            if (HasAny(cards, 30012506, 77411244, 3405259, 1561110))
+                return "ABC";
+            if (HasAny(cards, 9126351, 12538374, 63948258, 84451804))
+                return "Frog";
+            return null;
+        }
+
+        private static string FindClosestKingProfile(HashSet<int> cards)
+        {
+            if (cards == null || cards.Count == 0)
+                return null;
+            EnsureKingProfileCache();
+            if (_kingProfiles == null || _kingProfiles.Count == 0)
+                return null;
+
+            int frequencyLimit = Math.Max(3, _kingProfiles.Count / 8);
+            string bestProfile = null;
+            int bestOverlap = 0;
+            double bestCoverage = 0;
+            foreach (KeyValuePair<string, HashSet<int>> entry in _kingProfiles.OrderBy(item => item.Key, StringComparer.Ordinal))
+            {
+                List<int> fingerprint = entry.Value
+                    .Where(id => _kingCardFrequency[id] <= frequencyLimit)
+                    .ToList();
+                if (fingerprint.Count == 0)
+                    continue;
+                int overlap = fingerprint.Count(cards.Contains);
+                double coverage = (double)overlap / fingerprint.Count;
+                if (overlap < 4 || (overlap < 6 && coverage < 0.18))
+                    continue;
+                if (overlap > bestOverlap || overlap == bestOverlap && coverage > bestCoverage)
+                {
+                    bestProfile = entry.Key;
+                    bestOverlap = overlap;
+                    bestCoverage = coverage;
+                }
+            }
+            if (bestProfile != null)
+            {
+                Logger.WriteLine("King of Anime matched " + bestProfile + " with " + bestOverlap
+                    + " archetype cards (" + Math.Round(bestCoverage * 100) + "% profile coverage).");
+            }
+            return bestProfile;
+        }
+
+        private static void EnsureKingProfileCache()
+        {
+            if (_kingProfiles != null)
+                return;
+            lock (_kingProfileLock)
+            {
+                if (_kingProfiles != null)
+                    return;
+                Dictionary<string, HashSet<int>> profiles = new Dictionary<string, HashSet<int>>(StringComparer.Ordinal);
+                Dictionary<int, int> frequencies = new Dictionary<int, int>();
+                foreach (string profileName in _decks.Keys.OrderBy(name => name, StringComparer.Ordinal))
+                {
+                    if (_kingExcludedProfiles.Contains(profileName))
+                        continue;
+                    DeckInstance profileInfo = _decks[profileName];
+                    string deckPath = Path.GetFullPath(Path.Combine(Program.AssetPath, "Decks", profileInfo.Deck + ".ydk"));
+                    if (!File.Exists(deckPath))
+                        continue;
+                    Deck profileDeck = Deck.Load(deckPath);
+                    if (profileDeck == null)
+                        continue;
+                    HashSet<int> profileCards = new HashSet<int>(profileDeck.Cards.Concat(profileDeck.ExtraCards));
+                    if (profileCards.Count < 5)
+                        continue;
+                    profiles[profileName] = profileCards;
+                    foreach (int cardId in profileCards)
+                    {
+                        int count;
+                        frequencies.TryGetValue(cardId, out count);
+                        frequencies[cardId] = count + 1;
+                    }
+                }
+                _kingCardFrequency = frequencies;
+                _kingProfiles = profiles;
+            }
+        }
+
+        private static bool HasAny(HashSet<int> cards, params int[] signatures)
+        {
+            return signatures.Any(cards.Contains);
+        }
