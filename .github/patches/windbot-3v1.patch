diff --git a/Game/AI/Decks/KingOfAnimeExecutor.cs b/Game/AI/Decks/KingOfAnimeExecutor.cs
new file mode 100644
index 0000000..afa36b3
--- /dev/null
+++ b/Game/AI/Decks/KingOfAnimeExecutor.cs
@@ -0,0 +1,240 @@
+﻿using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using YGOSharp.OCGWrapper.Enums;
+using WindBot;
+using WindBot.Game;
+using WindBot.Game.AI;
+
+namespace WindBot.Game.AI.Decks
+{
+    /// <summary>
+    /// Deterministic fallback used by the King of Anime engine when the selected
+    /// deck does not match one of WindBot's dedicated anime strategy profiles.
+    /// Dedicated profiles are selected in DecksManager before this class is used.
+    /// </summary>
+    [Deck("KingOfAnime", "AI_Test", "Test")]
+    public class KingOfAnimeExecutor : DefaultExecutor
+    {
+        private static readonly object MemoryLock = new object();
+        private static readonly Dictionary<int, int> OpponentTacticMemory = LoadTacticMemory();
+        private static bool MemoryDirty;
+        private static readonly HashSet<int> ForbiddenOnePieces = new HashSet<int>
+        {
+            _CardId.ExodiaTheForbiddenOne,
+            _CardId.LeftArmofTheForbiddenOne,
+            _CardId.RightArmofTheForbiddenOne,
+            _CardId.LeftLegofTheForbiddenOne,
+            _CardId.RightLegofTheForbiddenOne
+        };
+
+        public KingOfAnimeExecutor(GameAI ai, Duel duel)
+            : base(ai, duel)
+        {
+            // High-value generic interaction is evaluated before the fallback.
+            AddExecutor(ExecutorType.Activate, _CardId.MysticalSpaceTyphoon, DefaultMysticalSpaceTyphoon);
+            AddExecutor(ExecutorType.Activate, _CardId.CosmicCyclone, DefaultCosmicCyclone);
+            AddExecutor(ExecutorType.Activate, _CardId.GalaxyCyclone, DefaultGalaxyCyclone);
+            AddExecutor(ExecutorType.Activate, _CardId.BookOfMoon, DefaultBookOfMoon);
+            AddExecutor(ExecutorType.Activate, _CardId.CompulsoryEvacuationDevice, DefaultCompulsoryEvacuationDevice);
+            AddExecutor(ExecutorType.Activate, _CardId.CallOfTheHaunted, DefaultCallOfTheHaunted);
+            AddExecutor(ExecutorType.Activate, _CardId.MaxxC, DefaultMaxxC);
+            AddExecutor(ExecutorType.Activate, _CardId.AshBlossom, DefaultAshBlossomAndJoyousSpring);
+            AddExecutor(ExecutorType.Activate, _CardId.GhostOgreAndSnowRabbit, DefaultGhostOgreAndSnowRabbit);
+            AddExecutor(ExecutorType.Activate, _CardId.GhostBelle, DefaultGhostBelleAndHauntedMansion);
+            AddExecutor(ExecutorType.Activate, _CardId.EffectVeiler, DefaultEffectVeiler);
+            AddExecutor(ExecutorType.Activate, _CardId.CalledByTheGrave, DefaultCalledByTheGrave);
+            AddExecutor(ExecutorType.Activate, _CardId.InfiniteImpermanence, DefaultInfiniteImpermanence);
+            AddExecutor(ExecutorType.Activate, _CardId.SolemnJudgment, DefaultSolemnJudgment);
+            AddExecutor(ExecutorType.Activate, _CardId.SolemnWarning, DefaultSolemnWarning);
+            AddExecutor(ExecutorType.Activate, _CardId.SolemnStrike, DefaultSolemnStrike);
+            AddExecutor(ExecutorType.Activate, _CardId.TorrentialTribute, DefaultTorrentialTribute);
+            AddExecutor(ExecutorType.Activate, _CardId.HeavyStorm, DefaultHeavyStorm);
+            AddExecutor(ExecutorType.Activate, _CardId.HarpiesFeatherDuster, DefaultHarpiesFeatherDusterFirst);
+            AddExecutor(ExecutorType.Activate, _CardId.DarkHole, DefaultDarkHole);
+            AddExecutor(ExecutorType.Activate, _CardId.Raigeki, DefaultRaigeki);
+            AddExecutor(ExecutorType.Activate, _CardId.SmashingGround, DefaultSmashingGround);
+            AddExecutor(ExecutorType.Activate, _CardId.PotOfDesires, DefaultPotOfDesires);
+            AddExecutor(ExecutorType.Activate, _CardId.AllureofDarkness, DefaultAllureofDarkness);
+
+            AddExecutor(ExecutorType.SpSummon, _CardId.JizukirutheStarDestroyingKaiju, DefaultKaijuSpsummon);
+            AddExecutor(ExecutorType.SpSummon, _CardId.GadarlatheMysteryDustKaiju, DefaultKaijuSpsummon);
+            AddExecutor(ExecutorType.SpSummon, _CardId.GamecieltheSeaTurtleKaiju, DefaultKaijuSpsummon);
+            AddExecutor(ExecutorType.SpSummon, _CardId.RadiantheMultidimensionalKaiju, DefaultKaijuSpsummon);
+            AddExecutor(ExecutorType.SpSummon, _CardId.KumongoustheStickyStringKaiju, DefaultKaijuSpsummon);
+            AddExecutor(ExecutorType.SpSummon, _CardId.ThunderKingtheLightningstrikeKaiju, DefaultKaijuSpsummon);
+            AddExecutor(ExecutorType.SpSummon, _CardId.DogorantheMadFlameKaiju, DefaultKaijuSpsummon);
+
+            AddExecutor(ExecutorType.Activate, GenericActivate);
+            AddExecutor(ExecutorType.SpSummon, GenericSpecialSummon);
+            AddExecutor(ExecutorType.SummonOrSet, SmartNormalSummon);
+            AddExecutor(ExecutorType.Summon, SmartNormalSummon);
+            AddExecutor(ExecutorType.MonsterSet, GenericMonsterSet);
+            AddExecutor(ExecutorType.SpellSet, DefaultSpellSet);
+            AddExecutor(ExecutorType.Repos, DefaultMonsterRepos);
+        }
+
+        private bool GenericActivate()
+        {
+            return !DefaultCheckWhetherCardIsNegated(Card) && DefaultDontChainMyself();
+        }
+
+        private bool GenericSpecialSummon()
+        {
+            return !ForbiddenOnePieces.Contains(Card.Id);
+        }
+
+        private bool SmartNormalSummon()
+        {
+            return !ForbiddenOnePieces.Contains(Card.Id) && DefaultMonsterSummon();
+        }
+
+        private bool GenericMonsterSet()
+        {
+            return !ForbiddenOnePieces.Contains(Card.Id) && Card.Level <= 4;
+        }
+
+        public override bool OnSelectHand()
+        {
+            // The generic strategy develops its board first; dedicated profiles can override this.
+            return true;
+        }
+
+        public override void OnChaining(int player, ClientCard card)
+        {
+            base.OnChaining(player, card);
+            if (player != 1 || card == null || card.Id <= 0)
+                return;
+            lock (MemoryLock)
+            {
+                int uses;
+                OpponentTacticMemory.TryGetValue(card.Id, out uses);
+                OpponentTacticMemory[card.Id] = Math.Min(1000, uses + 1);
+                MemoryDirty = true;
+            }
+        }
+
+        public override void OnNewTurn()
+        {
+            base.OnNewTurn();
+            SaveTacticMemory();
+        }
+
+        public override IList<ClientCard> OnSelectCard(IList<ClientCard> cards, int min, int max, long hint, bool cancelable)
+        {
+            IList<ClientCard> inherited = base.OnSelectCard(cards, min, max, hint, cancelable);
+            if (inherited != null)
+                return inherited;
+            if (cards == null || cards.Count == 0 || min != 1 || max != 1)
+                return null;
+
+            if (hint == HintMsg.Destroy || hint == HintMsg.Remove || hint == HintMsg.ReturnToHand
+                || hint == HintMsg.Control || hint == HintMsg.AttackTarget || hint == HintMsg.Target
+                || hint == HintMsg.Disable || hint == HintMsg.Negate)
+            {
+                ClientCard threat = cards
+                    .Where(card => card != null && card.Controller == 1)
+                    .OrderByDescending(GetThreatValue)
+                    .FirstOrDefault();
+                if (threat != null)
+                    return new List<ClientCard> { threat };
+            }
+
+            if (hint == HintMsg.Release || hint == HintMsg.Discard || hint == HintMsg.Tribute)
+            {
+                ClientCard expendable = cards
+                    .Where(card => card != null && card.Controller == 0 && !ForbiddenOnePieces.Contains(card.Id))
+                    .OrderBy(GetThreatValue)
+                    .FirstOrDefault();
+                if (expendable != null)
+                    return new List<ClientCard> { expendable };
+            }
+
+            if (hint == HintMsg.SpSummon || hint == HintMsg.ToField)
+            {
+                ClientCard strongest = cards
+                    .Where(card => card != null)
+                    .OrderByDescending(GetThreatValue)
+                    .FirstOrDefault();
+                if (strongest != null)
+                    return new List<ClientCard> { strongest };
+            }
+            return null;
+        }
+
+        private static int GetThreatValue(ClientCard card)
+        {
+            if (card == null)
+                return Int32.MinValue;
+            int power = Math.Max(card.Attack, card.GetDefensePower());
+            if (card.IsFaceup())
+                power += 250;
+            if (card.IsExtraCard())
+                power += 500;
+            lock (MemoryLock)
+            {
+                int rememberedUses;
+                if (OpponentTacticMemory.TryGetValue(card.Id, out rememberedUses))
+                    power += Math.Min(2500, rememberedUses * 125);
+            }
+            return power;
+        }
+
+        private static Dictionary<int, int> LoadTacticMemory()
+        {
+            Dictionary<int, int> result = new Dictionary<int, int>();
+            try
+            {
+                string path = Path.Combine(Program.AssetPath, "KingOfAnime.memory");
+                if (!File.Exists(path))
+                    return result;
+                foreach (string line in File.ReadAllLines(path))
+                {
+                    string[] fields = line.Split(new char[] { ':' });
+                    int id;
+                    int uses;
+                    if (fields.Length == 2 && Int32.TryParse(fields[0], out id)
+                        && Int32.TryParse(fields[1], out uses) && id > 0 && uses > 0)
+                        result[id] = Math.Min(1000, uses);
+                }
+            }
+            catch (Exception exception)
+            {
+                Logger.WriteLine("King of Anime could not load tactic memory: " + exception.Message);
+            }
+            return result;
+        }
+
+        private static void SaveTacticMemory()
+        {
+            lock (MemoryLock)
+            {
+                if (!MemoryDirty)
+                    return;
+                try
+                {
+                    string path = Path.Combine(Program.AssetPath, "KingOfAnime.memory");
+                    string[] lines = OpponentTacticMemory
+                        .OrderByDescending(entry => entry.Value)
+                        .ThenBy(entry => entry.Key)
+                        .Take(512)
+                        .Select(entry => entry.Key + ":" + entry.Value)
+                        .ToArray();
+                    File.WriteAllLines(path, lines);
+                    MemoryDirty = false;
+                }
+                catch (Exception exception)
+                {
+                    Logger.WriteLine("King of Anime could not save tactic memory: " + exception.Message);
+                }
+            }
+        }
+
+        public override int OnSelectOption(IList<long> options)
+        {
+            // Stable decisions make replays reproducible and avoid Lucky's random choices.
+            return options.Count == 0 ? -1 : 0;
+        }
+    }
+}
