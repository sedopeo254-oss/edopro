+        private static int CreateKingSeed(Deck deck, string profile)
+        {
+            unchecked
+            {
+                int seed = 17;
+                foreach (char character in profile ?? String.Empty)
+                    seed = seed * 31 + character;
+                if (deck != null)
+                {
+                    foreach (int cardId in deck.Cards.Concat(deck.ExtraCards).OrderBy(id => id))
+                        seed = seed * 31 + cardId;
+                }
+                return seed;
+            }
+        }
