@@ -436,0 +441,38 @@ namespace WindBot.Game
+        private IList<ClientCard> SelectKingLearnedCards(IList<ClientCard> cards, int min,
+            int max, long hint, bool cancelable)
+        {
+            if (_kingLearning == null || cards == null || cards.Count < min || min <= 0)
+                return null;
+
+            bool opponentTarget = hint == HintMsg.Destroy || hint == HintMsg.Remove
+                || hint == HintMsg.ReturnToHand || hint == HintMsg.Control
+                || hint == HintMsg.Target || hint == HintMsg.Disable
+                || hint == HintMsg.Negate || hint == HintMsg.ToDeck
+                || hint == HintMsg.AttackTarget && !cancelable;
+            bool ownChoice = hint == HintMsg.ToField || hint == HintMsg.AddToHand
+                || hint == HintMsg.SpSummon;
+            bool costChoice = hint == HintMsg.Release || hint == HintMsg.Discard
+                || hint == HintMsg.Tribute;
+            if (!opponentTarget && !ownChoice && !costChoice)
+                return null;
+
+            IEnumerable<ClientCard> candidates = cards.Where(card => card != null);
+            if (opponentTarget)
+                candidates = candidates.Where(card => card.Controller == 1)
+                    .OrderByDescending(card => _kingLearning.GetThreatScore(card.Id))
+                    .ThenByDescending(card => System.Math.Max(card.Attack, card.GetDefensePower()))
+                    .ThenBy(card => card.Id).ThenBy(card => card.Sequence);
+            else if (costChoice)
+                candidates = candidates.Where(card => card.Controller == 0)
+                    .OrderBy(card => _kingLearning.GetSolutionScore(card.Id))
+                    .ThenBy(card => System.Math.Max(card.Attack, card.GetDefensePower()))
+                    .ThenBy(card => card.Id).ThenBy(card => card.Sequence);
+            else
+                candidates = candidates.OrderByDescending(card => _kingLearning.GetSolutionScore(card.Id))
+                    .ThenByDescending(card => System.Math.Max(card.Attack, card.GetDefensePower()))
+                    .ThenBy(card => card.Id).ThenBy(card => card.Sequence);
+
+            IList<ClientCard> learned = candidates.Take(System.Math.Min(max, cards.Count)).ToList();
+            return learned.Count >= min ? learned : null;
+        }
+
