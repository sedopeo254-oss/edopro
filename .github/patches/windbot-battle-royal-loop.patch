+        private MainPhaseAction SelectIdleActionWithoutMultiplayerSpellLoop(MainPhase main)
+        {
+            // Independent multiplayer can project several logical fields through the same
+            // physical core side. If a stale SET->ACTIVATE transition is mirrored back to
+            // WindBot, the exact same face-down Spell may be offered again forever.
+            // Guard only that multiplayer-only state: Standard duels are untouched and
+            // face-up Continuous/Field Spell effects remain repeatable when legal.
+            int safety = main.ActivableCards.Count + 1;
+            while (safety-- > 0)
+            {
+                MainPhaseAction action = _ai.OnSelectIdleCmd(main);
+                if (!_duel.IsIndependentMultiplayer || action.Action != MainPhaseAction.MainAction.Activate)
+                    return action;
+
+                int listIndex = -1;
+                long description = 0;
+                ClientCard selected = null;
+                for (int i = 0; i < main.ActivableCards.Count; ++i)
+                {
+                    ClientCard card = main.ActivableCards[i];
+                    long desc = i < main.ActivableDescs.Count ? main.ActivableDescs[i] : 0;
+                    int responseIndex;
+                    if (card != null && card.ActionActivateIndex.TryGetValue(desc, out responseIndex)
+                        && responseIndex == action.Index)
+                    {
+                        selected = card;
+                        description = desc;
+                        listIndex = i;
+                        break;
+                    }
+                }
+
+                if (selected == null || !selected.IsSpell()
+                    || selected.Location != CardLocation.SpellZone || !selected.IsFacedown())
+                    return action;
+
+                string key = selected.Id + ":" + selected.Controller + ":"
+                    + selected.Sequence + ":" + description;
+                int attempts;
+                _multiplayerFacedownSpellActivations.TryGetValue(key, out attempts);
+                if (attempts == 0)
+                {
+                    _multiplayerFacedownSpellActivations[key] = 1;
+                    return action;
+                }
+
+                Logger.WriteLine("WindBot multiplayer loop guard skipped a repeated face-down Spell activation: "
+                    + (selected.Name ?? selected.Id.ToString()) + ".");
+                main.ActivableCards.RemoveAt(listIndex);
+                if (listIndex < main.ActivableDescs.Count)
+                    main.ActivableDescs.RemoveAt(listIndex);
+            }
+
+            if (main.CanBattlePhase)
+                return new MainPhaseAction(MainPhaseAction.MainAction.ToBattlePhase);
+            return new MainPhaseAction(MainPhaseAction.MainAction.ToEndPhase);
+        }
