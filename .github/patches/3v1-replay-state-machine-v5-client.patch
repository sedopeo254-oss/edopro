+void ClientField::RefreshThreeVsOneReplayField() {
+	RefreshLogicalDeckMasters();
+	auto refresh = [](ClientCard* const& pcard) {
+		if(!pcard)
+			return;
+		pcard->UpdateDrawCoordinates(true);
+		pcard->is_moving = false;
+		pcard->refresh_on_stop = false;
+		pcard->aniFrame = 0;
+	};
+	for(uint8_t player = 0; player < 2; ++player) {
+		for(auto* pcard : mzone[player])
+			refresh(pcard);
+		for(auto* pcard : szone[player])
+			refresh(pcard);
+		refresh(skills[player]);
+	}
+	for(auto* pcard : overlay_cards)
+		refresh(pcard);
+	for(auto& chain : chains)
+		chain.UpdateDrawCoordinates();
+}
+void ClientField::RefreshThreeVsOneReplayHands() {
+	for(auto& player_hand : hand)
+		for(auto* pcard : player_hand)
+			if(pcard)
+				pcard->UpdateDrawCoordinates(true);
+	mainGame->should_refresh_hands = true;
+}
+void ClientField::RefreshMultiplayerPrivatePile(uint8_t player) {
+	if(player > 1)
+		return;
+	auto refresh = [](ClientCard* pcard) {
+		if(!pcard)
+			return;
+		pcard->UpdateDrawCoordinates(true);
+		pcard->is_moving = false;
+		pcard->refresh_on_stop = false;
+		pcard->aniFrame = 0;
+	};
+	for(auto* pcard : deck[player])
+		refresh(pcard);
+	for(auto* pcard : hand[player])
+		refresh(pcard);
+	for(auto* pcard : extra[player])
+		refresh(pcard);
+	for(auto* pcard : grave[player])
+		refresh(pcard);
+	for(auto* pcard : remove[player])
+		refresh(pcard);
+	mainGame->should_refresh_hands = true;
+}
